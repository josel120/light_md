# Maintainer: community contribution for light_md
#
# Builds the v${pkgver} release from GitHub. For a new release, bump pkgver
# and update sha256sums (run `updpkgsums` or `makepkg -g`).
pkgname=light_md
pkgver=1.4.0
pkgrel=1
pkgdesc="Lightweight Markdown editor with live preview"
arch=('x86_64')
url="https://github.com/josel120/light_md"
license=('MIT')
depends=('qt6-base' 'qt6-wayland' 'hunspell')
optdepends=('hunspell-en_us: English spell checking'
            'hunspell-es_es: Spanish spell checking'
            'hunspell-fr: French spell checking'
            'hunspell-de: German spell checking')
makedepends=('cmake' 'ninja' 'pkgconf' 'qt6-base' 'qt6-tools')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('e591ebfd30778ef64a7ec9b8239ffad262e9a9c9e2f507019c81f66559604c26')

build() {
  cmake -S "$srcdir/$pkgname-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DLIGHT_MD_DOWNLOAD_DICTIONARIES=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$srcdir/$pkgname-$pkgver/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
