# Maintainer: community contribution for light_md
#
# Template for a future Arch package. The v${pkgver} GitHub tag and a real
# sha256sums entry do not exist yet — keep sha256sums=('SKIP') until a release
# is tagged, or build from a local source tree instead.
pkgname=light_md
pkgver=1.1.0
pkgrel=1
pkgdesc="Lightweight Markdown editor with live preview"
arch=('x86_64')
url="https://github.com/josel120/light_md"
license=('MIT')
depends=('qt6-base' 'qt6-wayland')
makedepends=('cmake' 'ninja' 'qt6-base')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cmake -S "$srcdir/$pkgname-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$srcdir/$pkgname-$pkgver/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
