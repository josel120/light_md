# Maintainer: community contribution for light_md
#
# Builds the v${pkgver} release from GitHub. For a new release, bump pkgver
# and update sha256sums (run `updpkgsums` or `makepkg -g`).
pkgname=light_md
pkgver=1.2.0
pkgrel=1
pkgdesc="Lightweight Markdown editor with live preview"
arch=('x86_64')
url="https://github.com/josel120/light_md"
license=('MIT')
depends=('qt6-base' 'qt6-wayland')
makedepends=('cmake' 'ninja' 'qt6-base')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('4da58f71c721458db86e4c0bcba0699747c8bca355e7ffac35d868d8f473634c')

build() {
  cmake -S "$srcdir/$pkgname-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$srcdir/$pkgname-$pkgver/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
